  "category": "permeability",
  "params": {
    "perm": {
      "meaning": "isotropic hydraulic permeability k0 in the reference state",
      "unit": "[L⁴/F·t]",
      "required": false
    },
    "M": {
      "meaning": "exponential strain-dependence coefficient M",
      "unit": "[ ]",
      "range": "M ≥ 0",
      "required": false
    },
    "alpha": {
      "meaning": "power-law exponent α",
      "unit": "[ ]",
      "range": "α ≥ 0",
      "required": false
    }
  },
  "example": {
    "spec": {
      "type": "perm-Holmes-Mow",
      "perm": 0.001,
      "M": 1.5,
      "alpha": 2
    },
